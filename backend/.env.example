PORT=5000

# Optional: allows the /api/ai routes to call Google Gemini for real AI-generated
# profile fixes and career insights. Get a free key at https://aistudio.google.com/apikey
# If left blank, the backend automatically falls back to a solid rule-based
# heuristic engine so the app still works out of the box.
GEMINI_API_KEY=""

# Model to use if GEMINI_API_KEY is set. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173